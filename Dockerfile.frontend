FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM nginx:alpine
RUN apk add --no-cache gettext

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf.template
EXPOSE 80

# Substitute $BACKEND_URL at runtime so the proxy target is configurable.
# Railway: set BACKEND_URL=http://backend.railway.internal:8000
# Default falls back to Railway private networking convention.
CMD ["/bin/sh", "-c", \
  "BACKEND_URL=${BACKEND_URL:-http://backend.railway.internal:8000} \
   envsubst '$BACKEND_URL' < /etc/nginx/conf.d/default.conf.template \
   > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
